# 股市故事 settings (read by deskctl.sh). Edit freely.
MODE=prod                 # prod = fast prebuilt pages (default); dev = make dev, hot reload but slow first loads
BROWSER_APP=Safari        # browser that opens 📈 股市故事 (at login and from the desktop icon)
OPEN_DASHBOARD=0          # 1 = also open the old standalone data page on :2027
EDITOR_APP=""             # e.g. "Visual Studio Code", "Cursor", "TextEdit"; empty = auto-detect
SAVED_PATH="/Users/mac/.nvm/versions/node/v22.22.2/bin:/usr/local/bin:/System/Cryptexes/App/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/local/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/appleinternal/bin:/Users/mac/.local/bin"
